<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BedrockSourceDir Condition="Exists('../../BedrockLoader')">../../BedrockLoader</BedrockSourceDir>
    <BedrockSourceDir Condition="'$(BedrockSourceDir)' == ''">../..</BedrockSourceDir>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(BedrockSourceDir)/ModCatalog.cs" Link="ModCatalog.cs" /></ItemGroup>
</Project>
