<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BedrockSourceDir Condition="Exists('../../BedrockLoader-v0.12')">../../BedrockLoader-v0.12</BedrockSourceDir>
    <BedrockSourceDir Condition="'$(BedrockSourceDir)' == ''">../..</BedrockSourceDir>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(BedrockSourceDir)/PackLibrary.cs" Link="PackLibrary.cs" /></ItemGroup>
</Project>
